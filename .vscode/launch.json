{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Run CodeHabit Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/codehabit"
      ],
      "outFiles": [
        "${workspaceFolder}/codehabit/out/**/*.js"
      ],
      "preLaunchTask": "Compile CodeHabit"
    }
  ]
}
